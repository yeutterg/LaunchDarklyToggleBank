# LaunchDarkly Configuration
NEXT_PUBLIC_LD_CLIENT_KEY=your_launchdarkly_client_key_here
LD_SDK_KEY=your_launchdarkly_server_sdk_key_here
LD_API_KEY=your_launchdarkly_api_key_here
DESTINATIONENV=production
PROJECT_KEY=your_project_key_here

# Database Configuration
DB_URL=postgresql://postgres:password@postgres:5432/togglebank
POSTGRES_DB=togglebank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# AWS Configuration (for Bedrock integration)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_DEFAULT_REGION=us-east-1